# Dockerfile.desktop — the desktop GUI (desktop/): a Dear ImGui shell over the
# .asmtrace document model, built as two binaries (full app + render-only
# viewer). Built on the bindings base (C/C++ toolchain + libunicorn and
# pinned-source Keystone/Capstone — the full app links them, D4), adding the GLFW
# + OpenGL3 app-backend dev packages the desktop targets need.
#
# The CMD builds BOTH binaries (proving the app links the engines and the viewer
# does not) and runs the headless null-backend tests. It does NOT run the app or
# viewer — those need a display; the container has none, and desktop-test needs
# no display or GL at all.
#
# Version pin: the distro packages, resolved against this image's pinned Ubuntu
# base — same discipline as Dockerfile.cli's libipt-dev / libncurses-dev.
ARG BASE_IMAGE=asmtest-bindings-base
FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
# libglfw3-dev + libgl1-mesa-dev: the app-backend build deps (03).
# libgl1-mesa-dri + libegl1-mesa-dev: software Mesa (llvmpipe) + EGL, so the 3D
# scene's FBO smoke (10-spacetime-3d-overview.md T4) renders offscreen via EGL
# surfaceless with NO X server. Version-pinned the same way as Dockerfile.cli's
# libipt-dev: the distro packages resolved against this image's pinned Ubuntu base.
# libfreetype-dev: the imgui freetype rasteriser (13-foundation-moves.md F3) —
# the app + viewer build with DESKTOP_FREETYPE=1 below. The fonts themselves load
# via stb_truetype and need none of this; freetype is the higher-quality path.
# ccache: the CMD below runs FOUR separate `make` trees in this one container
# (desktop, desktop-render, desktop-test, desktop-ui-test) that share most of
# their addon TUs (ImPlot/node-editor/TextEditor/etc. compile with identical
# flags in every tree — see mk/desktop.mk's per-tree addon rules) — so the
# second and third tree hit cache instead of recompiling them from scratch.
# Debian's ccache package puts compiler-name symlinks under /usr/lib/ccache, so
# prepending it to PATH is enough; no CC/CXX change needed in the Makefile.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libglfw3-dev libgl1-mesa-dev libgl1-mesa-dri libegl1-mesa-dev \
      libfreetype-dev ccache \
 && rm -rf /var/lib/apt/lists/*
ENV PATH=/usr/lib/ccache:$PATH
# Force software rendering for the headless GL smoke (no GPU in CI).
ENV LIBGL_ALWAYS_SOFTWARE=1
COPY . .
# DESKTOP_FREETYPE=1: the app + viewer link imgui's freetype rasteriser (F3). The
# headless desktop-test tree stays stb_truetype-only (no freetype), so it needs
# no libfreetype at link time — the fonts still load and render there.
CMD sh -c 'make desktop desktop-render desktop-test DESKTOP_FREETYPE=1 && make desktop-engine-boundary-check && make desktop-ui-test'
