#!/usr/bin/make -f
# debian/rules for asmtest-desktop — dh(1) sequencer (distribution-packaging.md
# desktop deb/AppImage lanes; packaging/debian holds the C-core equivalent).
#
# The full app links Unicorn/Keystone/Capstone directly (mk/desktop.mk
# DESKTOP_ENGINE_OBJ). Keystone and Capstone have no Debian package at all — like
# Dockerfile.bindings-base, they are built from pinned source
# (scripts/build-keystone.sh / build-capstone.sh) straight into /usr/local. Because
# dpkg-shlibdeps cannot find an owning package for either, the installed binary is
# relocated into a private libdir and all three engines vendored next to it with an
# $ORIGIN rpath (scripts/package-native.sh --app) — the standard Debian pattern for
# an app that bundles private third-party libraries. GLFW/GL/FreeType stay real apt
# Depends, auto-detected by dh_shlibdeps from the installed ELF.
#
# Source format: `3.0 (native)` for the in-tree CI lane (Dockerfile.syspkg-deb-desktop
# builds straight from the copied tree, no orig tarball); an archive upload would use
# `3.0 (quilt)` over a T7-style orig tarball instead, same as packaging/debian.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	./scripts/build-keystone.sh
	./scripts/build-capstone.sh
	$(MAKE) DESKTOP_FREETYPE=1 desktop

override_dh_auto_install:
	$(MAKE) desktop-install PREFIX=/usr DESTDIR=$(CURDIR)/debian/asmtest-desktop
	# Relocate the binary into a private libdir, vendor Unicorn/Keystone/Capstone
	# next to it (rpath $ORIGIN), and symlink /usr/bin back to it — the standard
	# shape for a package that bundles unpackaged private libraries. The .desktop
	# launcher's Exec= (already rewritten by desktop-install to /usr/bin/...) needs
	# no change: the symlink is what makes that path resolve.
	set -eu; \
	  root=$(CURDIR)/debian/asmtest-desktop; \
	  libdir=$$root/usr/lib/asmtest-desktop; \
	  mkdir -p $$libdir; \
	  mv $$root/usr/bin/asmtest-desktop $$libdir/asmtest-desktop; \
	  ln -s ../lib/asmtest-desktop/asmtest-desktop $$root/usr/bin/asmtest-desktop; \
	  ASMTEST_DEP_PREFIX=/usr/local ./scripts/package-native.sh --app $$libdir asmtest-desktop; \
	  mkdir -p $$root/usr/share/doc/asmtest-desktop; \
	  mv $$libdir/THIRD-PARTY-LICENSES $$root/usr/share/doc/asmtest-desktop/
	# desktop-install's update-desktop-database/gtk-update-icon-cache calls run
	# against THIS DESTDIR (mk/desktop.mk's own comment: a staging build "must not
	# poke the live caches"), which is right for the live system's caches but
	# leaves their generated cache files sitting in the staged tree — dh would
	# then ship them verbatim. Both are supposed to be regenerated by the target
	# system's own trigger/hook after install (dh_desktop / gtk-update-icon-cache's
	# trigger, wired automatically since this package ships a .desktop and icons),
	# not baked in at build time — lintian's package-contains-*-cache-file exists
	# for exactly this.
	rm -f $(CURDIR)/debian/asmtest-desktop/usr/share/applications/mimeinfo.cache
	rm -f $(CURDIR)/debian/asmtest-desktop/usr/share/icons/hicolor/icon-theme.cache

# dpkg-shlibdeps resolves GLFW/GL/FreeType fine (real Debian packages), but Keystone
# and Capstone are privately vendored with zero shlibs/symbols info anywhere on the
# system — --ignore-missing-info skips a dependency line for those instead of
# failing the build; the $ORIGIN rpath set above is what actually resolves them at
# runtime.
override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

# dh_dwz's multifile debug-info dedup chokes on the vendored trio: the apt-installed
# libunicorn.so.2 carries no .debug_info section at all (already stripped upstream),
# which it treats as a hard error rather than something to skip over. dwz is a size
# optimization for a separate -dbgsym package, not something this package's
# correctness depends on, so skip it rather than fight debhelper's multifile
# heuristics over a foreign, unmodified library we do not control.
override_dh_dwz:

# The vendored Unicorn/Keystone/Capstone copies under /usr/lib/asmtest-desktop/ are
# PRIVATE (found via the binary's own $ORIGIN rpath, never via ldconfig's search
# path or cache) — dh_makeshlibs' default postinst/postrm ldconfig trigger exists
# for PUBLIC shared libraries and is genuinely unnecessary here (lintian:
# package-has-unnecessary-activation-of-ldconfig-trigger). -n skips it.
override_dh_makeshlibs:
	dh_makeshlibs -n

# The framework/desktop self-tests need extra deps (imgui test engine, a display for
# the interaction lane) well beyond this package's scope; the install-time link is
# proven by the Docker lane's ldd + desktop-file-validate checks after `apt install`,
# not a build-time test target.
override_dh_auto_test:
